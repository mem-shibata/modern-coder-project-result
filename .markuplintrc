{
  "extends": [
    "markuplint:recommended"
  ],
  "parser": {
    "\\.astro$": "@markuplint/astro-parser"
  },
  "rules": {
    "required-h1": false,
    "heading-levels": false,
    "deprecated-attr": false,
    "doctype": false,
    "case-sensitive-tag-name": {
      "value": "lower",
      "severity": "error"
    },
    "case-sensitive-attr-name": {
      "value": "lower",
      "severity": "error"
    },
    "attr-value-quotes": {
      "value": "double",
      "severity": "error"
    }
  },
  "nodeRules": [
    {
      "selector": "img",
      "rules": {
        "required-attr": {
          "value": "alt",
          "severity": "error"
        }
      }
    },
    {
      "selector": "html",
      "rules": {
        "required-attr": {
          "value": [
            {
              "name": "lang",
              "value": "ja"
            }
          ],
          "severity": "error"
        },
        "ineffective-attr": false
      }
    },
    {
      "selector": "script",
      "rules": {
        "required-attr": false
      }
    }
  ]
}
