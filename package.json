{
  "name": "modern-coder-project-result",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "npm-run-all --parallel sass:watch dev:astro",
    "dev:astro": "astro dev",
    "start": "astro dev",
    "build": "astro build && npm run sass:build && npm run format:dist",
    "preview": "astro preview",
    "format": "prettier --write .",
    "format:dist": "prettier --write \"./dist/**/*.{html,mjs,js,json}\" --no-error-on-unmatched-pattern --ignore-path .prettierignore",
    "lint": "npm run lint:astro && npm run lint:css",
    "lint:astro": "markuplint \"src/**/*.astro\"",
    "lint:css": "stylelint \"src/styles/**/*.css\"",
    "prepare": "husky",
    "sass:build": "sass src/styles:dist/styles --no-source-map",
    "sass:watch": "sass --watch src/styles:public/styles --no-source-map"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "description": "",
  "dependencies": {
    "astro": "^5.13.3"
  },
  "devDependencies": {
    "@markuplint/astro-parser": "^4.6.21",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.5",
    "markuplint": "^4.13.1",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "sass": "^1.93.2",
    "sass-embedded": "^1.93.2",
    "stylelint": "^17.4.0",
    "stylelint-config-recess-order": "^7.6.1",
    "stylelint-config-standard": "^40.0.0"
  },
  "lint-staged": {
    "*.{js,mjs,ts,tsx,astro,css,md,json}": [
      "npm run format"
    ],
    "src/**/*.astro": [
      "npm run lint:astro"
    ],
    "src/styles/**/*.{css,scss}": [
      "npm run lint:css"
    ]
  }
}
